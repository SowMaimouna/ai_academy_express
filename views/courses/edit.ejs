<style>
    /* ==== Formulaires utilisateurs ==== */
    .data-form {
        max-width: 600px;
        margin: 40px auto;
        padding: 30px;
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
    }

    .data-form h2 {
        text-align: center;
        color: #2c3e50;
        margin-bottom: 30px;
        font-size: 1.8rem;
    }

    /* Champs du formulaire */
    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #34495e;
        font-weight: bold;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        font-size: 1rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        transition: border-color 0.3s ease;
    }

    .form-control:focus {
        border-color: #3498db;
        outline: none;
        box-shadow: 0 0 3px rgba(52, 152, 219, 0.5);
    }

    /* Bouton */
    .btn.btn-primary {
        width: 100%;
        background-color: #3498db;
        padding: 12px;
        font-size: 1rem;
        border: none;
        border-radius: 6px;
        color: #fff;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    .btn.btn-primary:hover {
        background-color: #2980b9;
    }
</style>
<div class="data-form"> 
    <form method="POST" action="<%= `/courses/${course._id}/update?_method=PUT` %>"> 
    <h2>Modifier le cours:</h2> 
    <div class="form-group"> 
    <label for="inputTitle">Titre</label> 
    <input type="text" name="title" id="inputTitle" class="form-control" value="<%= course.title 
    %>" placeholder="Titre du cours" autofocus required> 
    </div> 
    <div class="form-group"> 
    <label for="inputDescription">Description</label> 
    <textarea name="description" id="inputDescription" class="form-control" 
    placeholder="Description du cours" required><%= course.description %></textarea> 
    </div> 
    <div class="form-group"> 
    <label for="inputMaxStudents">Nombre maximum d'étudiants</label> 
    <input type="number" name="maxStudents" id="inputMaxStudents" class="form-control" 
    value="<%= course.maxStudents %>" placeholder="Nombre maximum d'étudiants" min="0"> 
    </div> 
    <div class="form-group"> 
    <label for="inputCost">Coût</label> 
    <input type="number" name="cost" id="inputCost" class="form-control" value="<%= 
    course.cost %>" placeholder="Coût du cours" min="0"> 
    </div> 
    <button type="submit" class="btn btn-primary">Mettre à jour</button> 
    </form> 
    </div> 