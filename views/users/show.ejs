<style>
    h3 {
  margin-top: 40px;
  font-size: 1.4rem;
  color: #2c3e50;
}

ul {
  list-style-type: none;
  margin-left: 20px;
}

h1 {
  text-align: center;
  font-size: 2rem;
  margin-bottom: 30px;
  color: #2c3e50;
}

.table {
  width: 60%;
  margin: 0 auto 30px;
  border-collapse: collapse;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.table th {
  background-color: #3498db;
  color: white;
  padding: 15px;
  text-align: left;
  width: 30%;
}

.table td {
  background-color: #f9f9f9;
  padding: 15px;
}

h4 {
  text-align: center;
  color: #27ae60;
  margin-bottom: 20px;
}

/* Boutons */
.button-group {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 30px;
}

.btn {
  padding: 10px 20px;
  border-radius: 5px;
  font-weight: bold;
  text-align: center;
  text-decoration: none;
  transition: background-color 0.3s;
}

.btn-primary {
  background-color: #3498db;
  color: white;
}

.btn-primary:hover {
  background-color: #2980b9;
}

.btn-info {
  background-color: #f39c12;
  color: white;
}

.btn-info:hover {
  background-color: #e67e22;
}

.btn-danger {
  background-color: #e74c3c;
  color: white;
}

.btn-danger:hover {
  background-color: #c0392b;
}

</style>
<h1>Profil utilisateur: <%= user.fullName %></h1> 
<table class="table"> 
<tr> 
<th>Nom complet</th> 
<td><%= user.fullName %></td> 
</tr> 
<tr> 
<th>Email</th> 
<td><%= user.email %></td> 
</tr> 
<tr> 
<th>Code Postal</th> 
<td><%= user.zipCode %></td> 
</tr> 
</table> 
<% if (user.subscribedAccount) { %> 
<h4>Cet utilisateur est lié à un compte abonné.</h4> 
<% } %>
<h3 class="btn btn-primary">Cours inscrits</h3>
<% if (enrollments.length > 0) { %>
  <ul>
    <% enrollments.forEach(e => { %>
      <li>
        <a href="/courses/<%= e.course._id %>">
          <%= e.course.title %>
        </a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>Aucun cours inscrit.</p>
<% } %>

<div class="button-group"> 
<a href="/users" class="btn btn-primary">Tous les utilisateurs</a> 
<a href="<%= `/users/${user._id}/edit` %>" class="btn btn-info">Modifier</a> 
<a href="<%= `/users/${user._id}/delete?_method=DELETE` %>"  
onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur?')"  
class="btn btn-danger"> 
Supprimer 
</a>
</div> 
