<style>
    /* ===== Liste des utilisateurs ===== */
h2 {
  text-align: center;
  font-size: 2rem;
  margin-bottom: 30px;
  color: #2c3e50;
}

/* Tableau stylé */
.table {
  width: 100%;
  border-collapse: collapse;
  margin: 0 auto;
  font-size: 1rem;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.table thead {
  background-color: #2c3e50;
  color: white;
}

.table th,
.table td {
  padding: 15px;
  text-align: left;
  border-bottom: 1px solid #ddd;
}

.table tbody tr:nth-child(even) {
  background-color: #f9f9f9;
}

.table tbody tr:hover {
  background-color: #ecf0f1;
}

/* Liens dans le tableau */
.table a {
  color: #2c3e50;
  font-weight: bold;
  transition: color 0.3s ease;
}

.table a:hover {
  color: #2c3e50;
  text-decoration: underline;
}

/* Bouton principal */
.btn-primary {
  display: inline-block;
  background-color: #2ecc71;
  color: white;
  padding: 12px 20px;
  font-size: 1rem;
  border: none;
  border-radius: 5px;
  margin-top: 30px;
  margin-left: auto;
  margin-right: auto;
  display: block;
  transition: background-color 0.3s ease;
  text-align: center;
}

.btn-primary:hover {
  background-color: #27ae60;
}

</style>
<h2>Liste des utilisateurs</h2> 
<table class="table"> 
  <thead> 
    <tr> 
      <th>Nom</th> 
      <th>Email</th> 
      <th>Code Postal</th> 
      <th>Modifier</th> 
      <th>Supprimer</th> 
    </tr> 
  </thead> 
  <tbody> 
    <% users.forEach(user => { %> 
    <tr> 
      <td> 
        <a href="<%= `/users/${user._id}` %>"> 
          <%= user.fullName %> 
        </a> 
      </td> 
      <td><%= user.email %></td> 
      <td><%= user.zipCode %></td> 
      <td> 
        <a href="<%= `/users/${user._id}/edit` %>"> 
          Modifier 
        </a> 
      </td> 
      <td> 
        <a href="<%= `/users/${user._id}/delete?_method=DELETE` %>"  
           onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur?')"> 
          Supprimer 
        </a> 
      </td> 
    </tr> 
    <% }); %> 
  </tbody> 
</table> 
<a href="/users/new" class="btn btn-primary">Créer un nouvel utilisateur</a>